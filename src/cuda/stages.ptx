 sub.u32 %r13,%r3,%r8; mul.wide.u32 %rd9,%r13,4; cvta.shared.u64 %rd10,sa; add.u64 %rd10,%rd10,%rd9; ld.shared.f32 %f2,[%rd10]; cvta.shared.u64 %rd10,sb; add.u64 %rd10,%rd10,%rd9; ld.shared.f32 %f3,[%rd10];
 mul.wide.u32 %rd11,%r3,4; cvta.shared.u64 %rd12,sa; add.u64 %rd12,%rd12,%rd11; ld.shared.f32 %f4,[%rd12]; cvta.shared.u64 %rd12,sb; add.u64 %rd12,%rd12,%rd11; ld.shared.f32 %f5,[%rd12];
 cvta.shared.u64 %rd12,sa; add.u64 %rd12,%rd12,%rd9; st.shared.f32 [%rd12],%f4; cvta.shared.u64 %rd12,sb; add.u64 %rd12,%rd12,%rd9; st.shared.f32 [%rd12],%f5;
 // Right prefix = left subtree total composed AFTER the parent prefix.
 mul.f32 %f6,%f2,%f4; mul.f32 %f7,%f2,%f5; add.f32 %f7,%f7,%f3; cvta.shared.u64 %rd12,sa; add.u64 %rd12,%rd12,%rd11; st.shared.f32 [%rd12],%f6; cvta.shared.u64 %rd12,sb; add.u64 %rd12,%rd12,%rd11; st.shared.f32 [%rd12],%f7;
