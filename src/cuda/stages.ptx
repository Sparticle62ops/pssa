AS_LOAD: mul.wide.u32 %rd7,%r3,4; cvta.shared.u64 %rd8,sa; add.u64 %rd8,%rd8,%rd7; st.shared.f32 [%rd8],%f0; cvta.shared.u64 %rd8,sb; add.u64 %rd8,%rd8,%rd7; st.shared.f32 [%rd8],%f1; bar.sync 0;
 mov.u32 %r8,1;
AS_UP: setp.ge.u32 %p2,%r8,%r2; @%p2 bra AS_ROOT;
 shl.b32 %r9,%r8,1; rem.u32 %r10,%r3,%r9; add.u32 %r11,%r8,%r8; sub.u32 %r12,%r11,1; setp.eq.u32 %p3,%r10,%r12; @!%p3 bra AS_UP_BARRIER;
 sub.u32 %r13,%r3,%r8; mul.wide.u32 %rd9,%r13,4; cvta.shared.u64 %rd10,sa; add.u64 %rd10,%rd10,%rd9; ld.shared.f32 %f2,[%rd10]; cvta.shared.u64 %rd10,sb; add.u64 %rd10,%rd10,%rd9; ld.shared.f32 %f3,[%rd10];
 mul.wide.u32 %rd11,%r3,4; cvta.shared.u64 %rd12,sa; add.u64 %rd12,%rd12,%rd11; ld.shared.f32 %f4,[%rd12]; cvta.shared.u64 %rd12,sb; add.u64 %rd12,%rd12,%rd11; ld.shared.f32 %f5,[%rd12];
 mul.f32 %f6,%f4,%f2; mul.f32 %f7,%f4,%f3; add.f32 %f7,%f7,%f5; cvta.shared.u64 %rd12,sa; add.u64 %rd12,%rd12,%rd11; st.shared.f32 [%rd12],%f6; cvta.shared.u64 %rd12,sb; add.u64 %rd12,%rd12,%rd11; st.shared.f32 [%rd12],%f7;
AS_UP_BARRIER: bar.sync 0; shl.b32 %r8,%r8,1; bra AS_UP;
AS_ROOT: setp.eq.u32 %p4,%r3,0; @!%p4 bra AS_DOWN_INIT;
 mov.u32 %r13,%r2; sub.u32 %r13,%r13,1; mul.wide.u32 %rd9,%r13,4; cvta.shared.u64 %rd10,sa; add.u64 %rd10,%rd10,%rd9; ld.shared.f32 %f0,[%rd10]; cvta.shared.u64 %rd10,sb; add.u64 %rd10,%rd10,%rd9; ld.shared.f32 %f1,[%rd10];
 mul.lo.u32 %r14,%r5,%r1; add.u32 %r14,%r14,%r4; mul.wide.u32 %rd11,%r14,4; add.u64 %rd12,%rd4,%rd11; st.global.f32 [%rd12],%f0; add.u64 %rd12,%rd5,%rd11; st.global.f32 [%rd12],%f1;
 // An exclusive Blelloch scan starts the downsweep with the identity map.
 cvta.shared.u64 %rd10,sa; add.u64 %rd10,%rd10,%rd9; st.shared.f32 [%rd10],0f3f800000;
 cvta.shared.u64 %rd10,sb; add.u64 %rd10,%rd10,%rd9; st.shared.f32 [%rd10],0f00000000;
AS_DOWN_INIT: bar.sync 0; mov.u32 %r8,%r2; shr.u32 %r8,%r8,1;
AS_DOWN: setp.eq.u32 %p5,%r8,0; @%p5 bra AS_WRITE;
