 rem.u32 %r7,%r6,%r1; div.u32 %r8,%r6,%r1; div.u32 %r8,%r8,%r2;
 mul.wide.u32 %rd4,%r6,4; add.u64 %rd6,%rd0,%rd4; ld.global.f32 %f0,[%rd6]; add.u64 %rd6,%rd1,%rd4; ld.global.f32 %f1,[%rd6];
