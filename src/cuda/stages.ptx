// CUDA stage kernels.  The affine scan is a tiled exclusive Blelloch scan:
// one block owns one independent channel and one lane owns one time row inside
// a tile.  Tile totals are scanned recursively and a final map composition adds
// the tile prefix.  The same decomposition maps directly to a WGSL workgroup.
.version 6.0
.target sm_50
.address_size 64

.visible .entry ssm_prepare(
 .param .u64 delta, .param .u64 b_proj, .param .u64 x_norm, .param .u64 rates,
 .param .u64 bar_a, .param .u64 bar_b, .param .u64 scan_b,
 .param .u32 len, .param .u32 d_m, .param .u32 d_s
) {
 .reg .pred %p<2>; .reg .b32 %r<18>; .reg .b64 %rd<14>; .reg .f32 %f<10>;
 ld.param.u64 %rd0,[delta]; ld.param.u64 %rd1,[b_proj]; ld.param.u64 %rd2,[x_norm]; ld.param.u64 %rd3,[rates];
 ld.param.u64 %rd4,[bar_a]; ld.param.u64 %rd5,[bar_b]; ld.param.u64 %rd6,[scan_b];
 ld.param.u32 %r0,[len]; ld.param.u32 %r1,[d_m]; ld.param.u32 %r2,[d_s];
 mov.u32 %r3,%tid.x; mov.u32 %r4,%ctaid.x; mov.u32 %r5,%ntid.x; mad.lo.u32 %r6,%r4,%r5,%r3;
 mul.lo.u32 %r7,%r1,%r2; mul.lo.u32 %r15,%r0,%r7; setp.ge.u32 %p0,%r6,%r15; @%p0 bra SP_EXIT;
 div.u32 %r8,%r6,%r7; rem.u32 %r9,%r6,%r7; div.u32 %r10,%r9,%r2; rem.u32 %r11,%r9,%r2;
 mul.lo.u32 %r12,%r8,%r1; add.u32 %r12,%r12,%r10; mul.wide.u32 %rd7,%r12,4; add.u64 %rd7,%rd0,%rd7; ld.global.f32 %f0,[%rd7];
 mul.wide.u32 %rd8,%r9,4; add.u64 %rd8,%rd3,%rd8; ld.global.f32 %f1,[%rd8]; mul.f32 %f2,%f0,%f1;
 mov.f32 %f3,0f3fb8aa3b; mul.f32 %f2,%f2,%f3; ex2.approx.f32 %f3,%f2;
 // Keep rd9 as a byte offset: each output has its own allocation base.
 mul.wide.u32 %rd9,%r6,4; add.u64 %rd12,%rd4,%rd9; st.global.f32 [%rd12],%f3;
 mul.lo.u32 %r13,%r8,%r2; add.u32 %r13,%r13,%r11; mul.wide.u32 %rd10,%r13,4; add.u64 %rd10,%rd1,%rd10; ld.global.f32 %f4,[%rd10];
 mul.f32 %f5,%f0,%f4; add.u64 %rd10,%rd5,%rd9; st.global.f32 [%rd10],%f5;
 mul.lo.u32 %r14,%r8,%r1; add.u32 %r14,%r14,%r10; mul.wide.u32 %rd11,%r14,4; add.u64 %rd11,%rd2,%rd11; ld.global.f32 %f6,[%rd11];
 mul.f32 %f7,%f5,%f6; add.u64 %rd10,%rd6,%rd9; st.global.f32 [%rd10],%f7;
SP_EXIT: ret;
}

// Tile-local exclusive scan.  summary receives the total map of each tile.
.visible .entry affine_scan(
 .param .u64 in_a, .param .u64 in_b, .param .u64 out_a, .param .u64 out_b,
 .param .u64 summary_a, .param .u64 summary_b,
 .param .u32 len, .param .u32 stride, .param .u32 capacity
) {
