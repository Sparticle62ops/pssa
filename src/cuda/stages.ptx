// Add the prefix of all preceding tiles to each local exclusive prefix.
.visible .entry scan_apply(
 .param .u64 scan_a, .param .u64 scan_b, .param .u64 prefix_a, .param .u64 prefix_b,
 .param .u32 len, .param .u32 stride, .param .u32 capacity
) {
 .reg .pred %p; .reg .b32 %r<13>; .reg .b64 %rd<10>; .reg .f32 %f<6>;
 ld.param.u64 %rd0,[scan_a]; ld.param.u64 %rd1,[scan_b]; ld.param.u64 %rd2,[prefix_a]; ld.param.u64 %rd3,[prefix_b]; ld.param.u32 %r0,[len]; ld.param.u32 %r1,[stride]; ld.param.u32 %r2,[capacity];
 mov.u32 %r3,%tid.x; mov.u32 %r4,%ctaid.x; mov.u32 %r5,%ntid.x; mad.lo.u32 %r6,%r4,%r5,%r3;
