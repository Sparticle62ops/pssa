 mul.lo.u32 %r6,%r5,%r2; add.u32 %r6,%r6,%r3; setp.ge.u32 %p1,%r6,%r0; @%p1 bra AS_IDENTITY;
 mul.lo.u32 %r7,%r6,%r1; add.u32 %r7,%r7,%r4; mul.wide.u32 %rd6,%r7,4; add.u64 %rd13,%rd0,%rd6; ld.global.f32 %f0,[%rd13]; add.u64 %rd13,%rd1,%rd6; ld.global.f32 %f1,[%rd13]; bra AS_LOAD;
