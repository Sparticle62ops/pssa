 mul.f32 %f4,%f0,%f2; mul.f32 %f5,%f0,%f3; add.f32 %f5,%f5,%f1; add.u64 %rd6,%rd0,%rd4; st.global.f32 [%rd6],%f4; add.u64 %rd6,%rd1,%rd4; st.global.f32 [%rd6],%f5;
SA_EXIT: ret;
}

