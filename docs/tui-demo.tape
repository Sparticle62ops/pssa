# Run from the repository root with pssa on PATH. No credentials needed.
Output docs/img/tui-demo.gif
Set Shell "bash"
Set FontSize 16
Set Width 1280
Set Height 800
Set Framerate 15
Set TypingSpeed 60ms
Hide
Type "pssa tui"
Enter
Sleep 1s
Show
Sleep 9s
Ctrl+k
Type "memory"
Sleep 1s
Enter
Sleep 3s
Type "?"
Sleep 4s
Escape
Ctrl+k
Type "monitor"
Enter
Sleep 4s
Hide
Ctrl+c
